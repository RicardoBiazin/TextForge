 b'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n<assembly xmlns='
 b'"urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">\n  <assemblyIde'
 b'ntity type="win32" name="TextForge" version="0.1.0.0" processorArchitecture='
 b'"amd64"/>\n  <description>TextForge - editor de arquivos tecnicos</descri'
 b'ption>\n  <!-- asInvoker, nunca requireAdministrator. Um editor nao preci'
 b'sa de privilegio,\n       e ELEVADO o arrastar-e-soltar do Explorer para '
 b'de funcionar: o Windows\n       proibe uma janela de integridade alta rec'
 b'eber drop de uma de integridade\n       media. Isso mataria o requisito 1'
 b'9. -->\n  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">\n    <secur'
 b'ity>\n      <requestedPrivileges>\n        <requestedExecutionLevel level='
 b'"asInvoker" uiAccess="false"/>\n      </requestedPrivileges>\n    </securi'
 b'ty>\n  </trustInfo>\n  <compatibility xmlns="urn:schemas-microsoft-com:com'
 b'patibility.v1">\n    <application>\n      <!-- Windows 10 e 11. Sem estes '
 b'GUIDs, GetVersionEx mente dizendo 8.1 e o\n           Qt escolhe caminhos'
 b' de compatibilidade antigos. -->\n      <supportedOS Id="{8e0f7a12-bfb3-4'
 b'fe8-b9a5-48fd50a15a9a}"/>\n      <supportedOS Id="{1f676c76-80e1-4239-95b'
 b'b-83d0f6d0da78}"/>\n      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4'
 b'a4a6e38}"/>\n    </application>\n  </compatibility>\n  <application xmlns="'
 b'urn:schemas-microsoft-com:asm.v3">\n    <windowsSettings>\n      <!-- Cami'
 b'nho longo: um .log em pasta funda de rede passa facil de 260\n           '
 b'caracteres, e sem isto o open() falha com um erro incompreensivel. -->\n '
 b'     <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSett'
 b'ings">true</longPathAware>\n      <!-- DPI por monitor: sem isto, arrasta'
 b'r a janela de um monitor 4K para um\n           1080p deixa a fonte borra'
 b'da ate\' reiniciar o programa. -->\n      <dpiAwareness xmlns="http://sche'
 b'mas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>\n'
 b'      <!-- UTF-8 como codepage do processo (Windows 10 1903+): faz as APIs A'
 b'NSI\n           usadas por bibliotecas de terceiros nao destruirem acento'
 b's. -->\n      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/201'
 b'9/WindowsSettings">UTF-8</activeCodePage>\n    </windowsSettings>\n  </app'
 b'lication>\n  <dependency>\n    <dependentAssembly>\n      <assemblyIdentity'
 b' type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0" pro'
 b'cessorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*"/>\n'
 b'    </dependentAssembly>\n  </dependency>\n</assembly>',
